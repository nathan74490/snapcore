// Schéma Prisma partagé entre apps/backend et apps/backoffice.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique // modifiable, unicité revérifiée à chaque changement (ADR-014)
  profilePhotoUrl   String?             // recadrée/redimensionnée côté app avant upload (ADR-014)
  phoneNumber       String?   @unique // collecté à l'onboarding, jamais vérifié (ADR-010)
  email             String?   @unique // collecté à l'onboarding, jamais vérifié (ADR-010)
  subscriptionTier  String    @default("free")
  premiumUntil      DateTime?
  createdAt         DateTime  @default(now())
}

model Message {
  id            String   @id @default(uuid())
  senderId      String
  recipientId   String
  contentType   String   // "TEXT" | "SNAP_PHOTO" | "SNAP_PHOTO_VIDEO" — voir ADR-009
  createdAt     DateTime @default(now())
}

model Friendship {
  id            String    @id @default(uuid())
  requesterId   String
  addresseeId   String
  status        String    @default("PENDING") // "PENDING" | "ACCEPTED" | "BLOCKED" | "DECLINED" — voir ADR-012
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@unique([requesterId, addresseeId])
}

model StoryItem {
  id            String   @id @default(uuid())
  authorId      String
  mediaUrl      String
  contentType   String   // "PHOTO" | "VIDEO" — voir ADR-013
  createdAt     DateTime @default(now())
  expiresAt     DateTime // createdAt + 24h ; déclenche le job BullMQ de purge existant
}
