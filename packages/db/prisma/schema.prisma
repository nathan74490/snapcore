// Schéma Prisma partagé entre apps/backend et apps/backoffice.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  free
  premium
}

enum MessageContentType {
  TEXT             // voir ADR-009
  SNAP_PHOTO
  SNAP_PHOTO_VIDEO
}

enum FriendshipStatus {
  PENDING          // voir ADR-012
  ACCEPTED
  BLOCKED
  DECLINED
}

enum StoryContentType {
  PHOTO            // voir ADR-013
  VIDEO
}

enum ModerationStatus {
  ACTIVE           // voir ADR-021
  SUSPENDED
}

enum ReportTargetType {
  USER             // voir ADR-021
  MESSAGE
  STORY_ITEM
}

enum ReportStatus {
  PENDING          // voir ADR-021
  RESOLVED
  DISMISSED
}

enum LocationSharingMode {
  GHOST            // voir ADR-031 : mode fantôme, valeur par défaut (confidentialité d'abord)
  ALL_FRIENDS
  FRIENDS_EXCEPT   // tous les amis sauf ceux de LocationShareRule
  ONLY_FRIENDS     // uniquement les amis de LocationShareRule
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique // normalisé en minuscules, modifiable, unicité revérifiée (ADR-014)
  firebaseUid       String    @unique // identifiant du compte Firebase Authentication (ADR-015)
  firstName         String?             // prénom affiché à la place du pseudo ; null pour les comptes créés avant son introduction
  lastName          String?             // nom de famille, facultatif et privé : jamais dans un profil public (ADR-029)
  birthday          DateTime? @db.Date  // date de naissance (13 ans révolus à l'inscription), privée ; null pour les comptes créés avant son introduction (ADR-029)
  profilePhotoUrl   String?             // URL publique CDN, recadrée/redimensionnée côté app avant upload (ADR-014, ADR-016)
  avatar            Json?               // options de l'avatar dessiné avataaars (AvatarOptions) ; null = pas d'avatar (ADR-028)
  phoneNumber       String?   @unique // collecté à l'onboarding, jamais vérifié (ADR-010)
  email             String?   @unique // copie de lecture de l'email Firebase ; Firebase reste la source de vérité pour la connexion, tout changement passe par verifyBeforeUpdateEmail avant mise à jour ici (ADR-014, ADR-015)
  subscriptionTier  SubscriptionTier @default(free)
  premiumUntil      DateTime?
  subscriptionEventAt DateTime? // date du dernier événement RevenueCat appliqué : un webhook plus ancien, arrivé en retard ou rejoué, est ignoré (ADR-025)
  createdAt         DateTime  @default(now())
  deletionRequestedAt DateTime? // renseigné au déclenchement de la suppression de compte ; bloque connexion/actions dès cet instant, avant même la fin du job de suppression (ADR-019)
  moderationStatus  ModerationStatus @default(ACTIVE) // SUSPENDED traité comme deletionRequestedAt non nul pour les autres utilisateurs, à vérifier au même endroit centralisé (ADR-021)
  suspendedAt       DateTime?
  suspendedById     String?
  suspendedBy       Moderator? @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspensionReason  String?
  locationSharing   LocationSharingMode @default(GHOST) // partage de position sur la Snap Map ; la position elle-même n'est jamais en base, seulement dans Redis avec TTL (ADR-003, ADR-031)

  sentMessages         Message[]     @relation("MessageSender")
  receivedMessages     Message[]     @relation("MessageRecipient")
  friendshipsSent      Friendship[]  @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]  @relation("FriendshipAddressee")
  friendshipsBlockedBy Friendship[]  @relation("FriendshipBlockedBy")
  storyItems           StoryItem[]
  deviceTokens         DeviceToken[]
  reportsMade          Report[]      @relation("ReportsMade")
  reportsReceived      Report[]      @relation("ReportsReceivedAsUser")
  locationShareRules   LocationShareRule[] @relation("LocationShareRuleOwner")
  locationShareTargets LocationShareRule[] @relation("LocationShareRuleFriend")
  groupsCreated        Group[]             @relation("GroupCreatedBy")
  groupMemberships     GroupMember[]
  groupMessagesSent    GroupMessage[]
  groupMessageViews    GroupMessageView[]
}

model Message {
  id                String             @id @default(uuid())
  senderId          String
  sender            User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId       String
  recipient         User               @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  contentType       MessageContentType // voir ADR-009
  content           String?            // texte du chat, renseigné uniquement si contentType = TEXT ; PERMANENT, jamais purgé par le job de purge — sauf rédaction par modération (ADR-009, ADR-021)
  mediaKey          String?            // clé d'objet R2 (jamais une URL), renseignée uniquement si contentType est un type de Snap ; vidée par la purge (ADR-009, ADR-016, ADR-017) ou par une rédaction de modération (ADR-021)
  createdAt         DateTime           @default(now())
  openedAt          DateTime?          // horodatage durable de la 1re ouverture ; null = jamais ouvert (ADR-009)
  scheduledPurgeAt  DateTime?          // uniquement pour les Snaps : createdAt + 30j par défaut, ramené à openedAt + 24h à l'ouverture, mis à jour à CHAQUE reprogrammation ; repoussé à premiumUntil + 24h si abonnement SnapCore+ actif ; toujours null pour un message TEXT (ADR-017)
  retainedNotifiedAt DateTime?         // renseigné au premier envoi de la notification "Snap conservé" à l'expéditeur, pour qu'elle ne parte qu'une seule fois même si la purge est évitée à plusieurs reprises (ADR-009)
  moderatedAt       DateTime?          // renseigné si un modérateur a rédigé ce message (content vidé ou mediaKey vidé + objet R2 supprimé) sans supprimer la ligne (ADR-021)
  moderatedById     String?
  moderatedBy       Moderator?         @relation("MessageModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationReason  String?

  reports Report[]

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId, createdAt]) // affichage d'une conversation
  @@index([scheduledPurgeAt])                 // sélection des Snaps à purger
  // Contrainte CHECK "Message_content_matches_type_check" en SQL brut (migration 20261015000000_message_content_check,
  // non exprimable en DSL Prisma, ADR-009) : TEXT → mediaKey et scheduledPurgeAt NULL, content non NULL sauf rédaction
  // (moderatedAt renseigné) ; Snap → content NULL et scheduledPurgeAt renseigné, mediaKey NULL une fois purgé ou rédigé.
}

model Friendship {
  id              String           @id @default(uuid())
  requesterId     String
  requester       User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId     String
  addressee       User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status          FriendshipStatus @default(PENDING) // voir ADR-012
  // onDelete: SetNull inatteignable en pratique : blockedBy référence toujours
  // requesterId ou addresseeId de la même ligne, qui cascadent avant que SetNull
  // ne puisse s'appliquer ; conservé pour la cohérence du schéma (ADR-019).
  blockedBy       String?
  blockedByUser   User?            @relation("FriendshipBlockedBy", fields: [blockedBy], references: [id], onDelete: SetNull)
  requestedAt     DateTime         @default(now()) // renommé depuis createdAt (ADR-012 v3) : plus explicite, une demande peut être BLOCKED sans jamais avoir été acceptée
  respondedAt     DateTime?

  // Paire triée (indépendante du sens) : empêche structurellement A→B et B→A
  // de coexister, y compris en cas de création concurrente (ADR-012).
  pairLow         String
  pairHigh        String

  @@unique([pairLow, pairHigh])
  @@index([addresseeId])
  // Contraintes CHECK ajoutées en SQL brut dans la migration initiale (non exprimables en DSL Prisma, ADR-012 v3) :
  //   CHECK ("requesterId" <> "addresseeId")                                   -- interdit l'auto-ajout
  //   CHECK ("pairLow" = LEAST("requesterId", "addresseeId")
  //          AND "pairHigh" = GREATEST("requesterId", "addresseeId"))          -- cohérence de la paire triée
}

model StoryItem {
  id            String           @id @default(uuid())
  authorId      String
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaKey      String           // clé d'objet R2, lue via URL pré-signée à la demande, jamais via CDN (ADR-013, ADR-016)
  contentType   StoryContentType // voir ADR-013
  thumbnailKey  String?          // vignette privée story-thumbnails/<id>, fabriquée par l'app ; null sans vignette (ADR-026)
  createdAt     DateTime         @default(now())
  expiresAt     DateTime         // createdAt + 24h ; déclenche le job BullMQ de purge (ADR-017)
  latitude      Float?           // position de publication arrondie à 3 décimales (~100 m), seulement si l'auteur ne partageait pas en mode fantôme (ADR-031)
  longitude     Float?

  reports Report[]

  @@index([authorId])
  @@index([expiresAt])
}

// Liste d'amis du partage de position (ADR-031) : exclus en FRIENDS_EXCEPT, autorisés en ONLY_FRIENDS.
// Conservée quel que soit le mode, pour qu'un retour à l'un de ces modes la retrouve.
model LocationShareRule {
  ownerId  String
  owner    User   @relation("LocationShareRuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("LocationShareRuleFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([ownerId, friendId])
  @@index([friendId])
}

// Groupes de discussion (ADR-032) : tables à part, la messagerie à deux (Message) n'est pas touchée.
// Pas d'administrateur : createdById n'est qu'une trace, remise à NULL si le créateur supprime son compte.
model Group {
  id          String   @id @default(uuid())
  name        String?  // facultatif, 1 à 50 caractères après trim (CHECK "Group_name_length_check") ; null = sans nom, l'app affiche les prénoms
  createdById String?
  createdBy   User?    @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]

  @@index([createdById])
}

// Appartenance actuelle : la ligne disparaît quand le membre quitte le groupe (ses messages restent).
model GroupMember {
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime  @default(now()) // le membre ne voit que les messages envoyés depuis son arrivée
  lastReadAt DateTime?                 // dernière ouverture de la conversation : un chat est lu si lastReadAt >= sa date

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id               String             @id @default(uuid())
  groupId          String
  group            Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  contentType      MessageContentType // mêmes types que Message (ADR-009)
  content          String?            // texte du chat, uniquement si TEXT ; permanent
  mediaKey         String?            // clé R2 group-messages/<id>, uniquement pour un snap ; vidée par la purge (ADR-017)
  createdAt        DateTime           @default(now())
  scheduledPurgeAt DateTime?          // snaps seulement : createdAt + 30j, rapprochée à dernière ouverture + 24h quand tous les membres présents à l'envoi l'ont ouvert ; jamais de conservation SnapCore+ (ADR-032)

  views GroupMessageView[]

  @@index([groupId, createdAt]) // historique d'un groupe, dernier message
  @@index([senderId])
  @@index([scheduledPurgeAt])   // balayage de rattrapage de la purge
  // Contrainte CHECK "GroupMessage_content_matches_type_check" en SQL brut (migration 20261105000000_groups),
  // équivalente à celle de Message sans la rédaction de modération : TEXT → content non NULL, mediaKey et
  // scheduledPurgeAt NULL ; snap → content NULL et scheduledPurgeAt renseigné, mediaKey NULL une fois purgé.
}

// Première ouverture d'un snap de groupe par un membre (vue unique par membre, ADR-032).
model GroupMessageView {
  messageId String
  message   GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  openedAt  DateTime

  @@id([messageId, userId])
  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // token FCM de l'appareil (ADR-018)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Moderator {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String            // bcrypt/argon2id, jamais en clair, jamais partagé avec un mot de passe Firebase (ADR-020)
  createdAt    DateTime @default(now())

  usersSuspended    User[]    @relation("UserSuspendedBy")
  messagesModerated Message[] @relation("MessageModeratedBy")
  reportsResolved   Report[]  @relation("ReportResolvedBy")
}

model Report {
  id                String           @id @default(uuid())
  reporterId        String
  reporter          User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType        ReportTargetType // voir ADR-021 : une seule des trois clés ci-dessous est renseignée, selon targetType
  targetUserId      String?
  targetUser        User?            @relation("ReportsReceivedAsUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetMessageId   String?
  targetMessage     Message?         @relation(fields: [targetMessageId], references: [id], onDelete: SetNull)
  targetStoryItemId String?
  targetStoryItem   StoryItem?       @relation(fields: [targetStoryItemId], references: [id], onDelete: SetNull)
  reason            String
  status            ReportStatus     @default(PENDING)
  createdAt         DateTime         @default(now())
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        Moderator?       @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetUserId])
  // Contrainte CHECK "Report_single_target_check" en SQL brut (migration 20260925150000_moderation,
  // non exprimable en DSL Prisma, ADR-021) : seule la clé correspondant à targetType peut être renseignée,
  // et elle peut devenir NULL quand le contenu visé disparaît (onDelete: SetNull ci-dessus).
}
