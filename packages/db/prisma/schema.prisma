// Schéma Prisma partagé entre apps/backend et apps/backoffice.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  subscriptionTier  String    @default("free")
  premiumUntil      DateTime?
  createdAt         DateTime  @default(now())
}

model Message {
  id            String   @id @default(uuid())
  senderId      String
  recipientId   String
  contentType   String   // "TEXT" | "SNAP_PHOTO" | "SNAP_PHOTO_VIDEO" — voir ADR-009
  createdAt     DateTime @default(now())
}
