# Copier en .env.local et renseigner les valeurs.
# Même base que le backend : le backoffice LIT directement PostgreSQL via Prisma (ADR-004, ADR-021).
DATABASE_URL=postgresql://snapcore:snapcore@localhost:5432/snapcore

# Sessions NextAuth des modérateurs (ADR-020) : secret aléatoire, 32 caractères minimum.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# Les actions de modération passent par l'API admin du backend (ADR-021).
BACKEND_URL=http://localhost:3000
# Même valeur que ADMIN_API_SECRET dans apps/backend/.env. Jamais exposée au navigateur.
ADMIN_API_SECRET=
