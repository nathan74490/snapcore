# Copier en .env et renseigner les valeurs.
PORT=3000
DATABASE_URL=postgresql://snapcore:snapcore@localhost:5432/snapcore

# Firebase Admin (ADR-015) : chemin vers le JSON du compte de service.
# Laisser vide en local pour utiliser GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cloudflare R2 (ADR-016) : jeton d'API de type Account, lecture/écriture sur le bucket uniquement.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snapcore-media

# Redis partagé (BullMQ, tickets d'upload, présence…) — voir docker-compose.yml
REDIS_URL=redis://localhost:6379

# Bucket PUBLIC réservé aux photos de profil (ADR-016) et son URL publique (sans / final).
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=

# Files BullMQ : purge des Snaps (ADR-017) et suppression de compte (ADR-019).
PURGE_QUEUE_NAME=media-purge
ACCOUNT_DELETION_QUEUE_NAME=account-deletion
# Workers de ces deux files ; false pour une instance qui ne sert que l'API.
# (Remplace PURGE_WORKER_ENABLED, encore lu en secours.)
WORKERS_ENABLED=true

# Notifications push FCM (ADR-018) : true = FCM valide les envois sans rien délivrer (tests, démo).
FCM_DRY_RUN=false

# Tests d'intégration : base dédiée. Vide = DATABASE_URL avec le nom de base suffixé de _test.
TEST_DATABASE_URL=

# API admin appelée par le backoffice (ADR-021) : secret partagé, 32 caractères minimum.
# Sans lui, l'API admin est fermée. Même valeur dans apps/backoffice/.env.local.
ADMIN_API_SECRET=

# SnapCore+ (ADR-025). Secret du webhook RevenueCat (32 caractères minimum), à recopier tel quel dans
# RevenueCat > Integrations > Webhooks > Authorization header. Sans lui, le webhook est fermé.
REVENUECAT_WEBHOOK_SECRET=
# Web Purchase Link sandbox de l'offre SnapCore+ (https://pay.rev.cat/<token>), sans identifiant à la fin.
# Vide = paiement indisponible (l'app affiche « SnapCore+ n'est pas encore disponible »).
REVENUECAT_PURCHASE_LINK=
# Entitlement RevenueCat qui donne accès à SnapCore+.
REVENUECAT_ENTITLEMENT_ID=snapcore_plus
