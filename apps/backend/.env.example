# Copier en .env et renseigner les valeurs.
PORT=3000
DATABASE_URL=postgresql://snapcore:snapcore@localhost:5432/snapcore

# Firebase Admin (ADR-015) : chemin vers le JSON du compte de service.
# Laisser vide en local pour utiliser GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cloudflare R2 (ADR-016) : jeton d'API de type Account, lecture/écriture sur le bucket uniquement.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snapcore-media

# Redis partagé (BullMQ, tickets d'upload, présence…) — voir docker-compose.yml
REDIS_URL=redis://localhost:6379

# Bucket PUBLIC réservé aux photos de profil (ADR-016) et son URL publique (sans / final).
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=

# Purge des Snaps (ADR-017) : file BullMQ et worker (désactivable pour une instance API seule).
PURGE_QUEUE_NAME=media-purge
PURGE_WORKER_ENABLED=true
