{
  "name": "@snapcore/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "seed:demo": "tsc -p tsconfig.scripts.json && node --enable-source-maps dist-scripts/scripts/seed-demo.js",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "jest",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testRegex \"\\.int-spec\\.ts$\" --setupFiles \"<rootDir>/test/integration-setup.ts\" --globalSetup \"<rootDir>/test/integration-global-setup.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/websockets": "^11.2.6",
    "@resvg/resvg-js": "^2.6.2",
    "@snapcore/db": "*",
    "@snapcore/types": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.15",
    "posthog-node": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "target": "ES2022",
            "esModuleInterop": true
          },
          "diagnostics": false
        }
      ]
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!@dicebear/)"
    ]
  }
}
